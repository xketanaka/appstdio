<% content_for :title do %><%= t(".title") %><% end -%>
<div class="shrink-0 px-4 pt-5 pb-3 sm:px-6">
  <h1 class="truncate text-title"><%= t(".heading") %></h1>
</div>

<div class="min-h-0 flex-1 overflow-y-auto">
  <div class="w-full max-w-2xl px-4 py-4 sm:px-6">
    <p class="mb-5 text-sm text-slate-500"><%= t(".message") %></p>

    <%= render "partial/errors", object: current_operator %>

    <%= form_with url: ops_password_path, method: :patch, id: "password-form" do |f| %>
      <%# パスワードの管理ソフトに、どのアカウントのパスワードかを伝える %>
      <input type="email" name="username" value="<%= current_operator.email %>" autocomplete="username" hidden>
      <div class="mb-5">
        <%= f.label :current_password, Operator.human_attribute_name(:password_challenge), class: "mb-1.5 block text-sm font-semibold" %>
        <%= f.password_field :current_password, autofocus: true, autocomplete: "current-password", required: true, class: "input" %>
      </div>
      <div class="mb-5">
        <%= f.label :password, t(".password"), class: "mb-1.5 block text-sm font-semibold" %>
        <%= f.password_field :password, autocomplete: "new-password", required: true, class: "input" %>
        <p class="mt-1 text-xs text-slate-500"><%= t(".password_hint") %></p>
      </div>
      <div class="mb-5">
        <%= f.label :password_confirmation, Operator.human_attribute_name(:password_confirmation), class: "mb-1.5 block text-sm font-semibold" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "input" %>
      </div>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-slate-200 pt-4">
        <%= f.submit t(".submit"), class: "btn btn-primary" %>
        <%= link_to t(".cancel"), ops_root_path, class: "text-sm whitespace-nowrap text-slate-600 hover:underline" %>
      </div>
    <% end %>
  </div>
</div>
