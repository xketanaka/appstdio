<% content_for :title do %><%= t(".title") %><% end -%>
<div class="shrink-0 px-4 pt-5 pb-3 sm:px-6">
  <h1 class="truncate text-title"><%= t(".heading") %></h1>
</div>

<div class="min-h-0 flex-1 overflow-y-auto">
  <div class="w-full max-w-2xl px-4 py-4 sm:px-6">
    <h2 class="mb-5 text-sm text-slate-500"><%= t(".detail") %></h2>

    <%= render "partial/errors", object: @operator %>

    <%= form_with model: @operator, url: ops_operators_path, id: "operator-form" do |f| %>
      <div class="mb-5">
        <%= f.label :email, class: "mb-1.5 block text-sm font-semibold" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "off", required: true, class: "input" %>
      </div>
      <div class="mb-5">
        <%= f.label :display_name, class: "mb-1.5 block text-sm font-semibold" %>
        <%= f.text_field :display_name, autocomplete: "off", required: true, class: "input" %>
      </div>

      <p class="mb-4 text-sm text-slate-500"><%= t(".invited_note", days: Operator::INVITATION_EXPIRES_IN.in_days.to_i) %></p>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-slate-200 pt-4">
        <%= f.submit t(".submit"), class: "btn btn-primary" %>
        <%= link_to t(".cancel"), ops_operators_path, class: "text-sm whitespace-nowrap text-slate-600 hover:underline" %>
      </div>
    <% end %>
  </div>
</div>
