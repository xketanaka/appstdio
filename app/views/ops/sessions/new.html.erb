<% content_for :title do %><%= t(".title") %><% end -%>
<div class="min-h-0 flex-1 overflow-y-auto px-4 py-10">
  <div class="mx-auto max-w-md rounded-3xl bg-white px-6 pt-7 pb-8 sm:px-10 sm:pt-9 sm:pb-10">
  <h1 class="mb-6 text-title"><%= t(".heading") %></h1>

  <%= form_with url: ops_login_path, method: :post do |f| %>
    <div class="mb-5">
      <%= f.label :email, Operator.human_attribute_name(:email), class: "mb-1.5 block text-sm font-semibold" %>
      <%= f.email_field :email, value: params[:email], autofocus: true,
            autocomplete: "username", class: ui_input_class %>
    </div>

    <div class="mb-5">
      <%= f.label :password, Operator.human_attribute_name(:password), class: "mb-1.5 block text-sm font-semibold" %>
      <%= f.password_field :password, autocomplete: "current-password", class: ui_input_class %>
    </div>

    <%= f.submit t("actions.login"), class: ui_button_class(extra: "w-full") %>
  <% end %>
</div>
</div>
