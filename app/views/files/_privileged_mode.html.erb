<%# PC とスマホの2箇所から描画される。id を持つ要素を置かないこと %>
<% if current_tenant_user.admin_or_owner? && !privileged_mode? %>
  <div class="mt-4 border-t border-slate-200 px-4 pt-3">
    <%= button_to t(".enter"), files_privileged_mode_path,
          class: "cursor-pointer text-sm text-slate-600 hover:underline" %>
    <p class="mt-1 text-xs text-slate-500"><%= t(".description") %></p>
  </div>
<% end %>
