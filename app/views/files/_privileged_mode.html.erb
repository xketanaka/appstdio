<%# PC とスマホの2箇所から描画される。id を持つ要素を置かないこと %>
<% if current_tenant_user.admin_or_owner? %>
  <div class="mt-4 border-t border-slate-200 px-4 pt-3">
    <%= button_to files_privileged_mode_path, method: (privileged_mode? ? :delete : :post),
          role: "switch", "aria-checked": privileged_mode?.to_s,
          class: "flex w-full cursor-pointer items-center justify-between gap-3 text-sm text-slate-700" do %>
      <span><%= t(".label") %></span>
      <span class="<%= class_names("relative inline-flex h-5 w-9 shrink-0 rounded-full transition-colors",
                                   privileged_mode? ? "bg-amber-500" : "bg-slate-300") %>">
        <span class="<%= class_names("absolute top-0.5 left-0.5 size-4 rounded-full bg-white shadow transition-transform",
                                     "translate-x-4": privileged_mode?) %>"></span>
      </span>
    <% end %>
    <p class="mt-1 text-xs text-slate-500"><%= t(".description") %></p>
  </div>
<% end %>
