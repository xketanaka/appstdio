<% content_for :title do %><%= t(".title") %><% end -%>
<div class="flex shrink-0 items-center justify-between gap-4 px-6 pt-5 pb-3">
  <div class="min-w-0">
    <% if @breadcrumbs.any? || @via_shared %>
      <nav aria-label="<%= t(".breadcrumbs") %>" class="mb-0.5 truncate text-sm text-slate-500">
        <% if @via_shared %>
          <%= link_to t("files.sections.shared_with_me"), files_shared_items_path, class: "hover:underline" %>
          <span aria-hidden="true">/</span>
        <% end %>
        <% @breadcrumbs.each do |node| %>
          <%= link_to node_label(node), files_folder_path(node), class: "hover:underline" %>
          <span aria-hidden="true">/</span>
        <% end %>
      </nav>
    <% end %>
    <h1 class="truncate text-title"><%= node_label(@folder) %></h1>
  </div>
  <% if @can_edit %>
    <%= button_tag type: "button",
          class: ui_button_class(size: :sm) do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4" aria-hidden="true">
        <path stroke-linecap="round" d="M12 5v14M5 12h14" />
      </svg>
      <%= t(".create") %>
    <% end %>
  <% end %>
</div>

<%= render "files/list", entries: @entries, permissions: @permissions, empty: t(".empty") %>
