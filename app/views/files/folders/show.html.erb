<% content_for :title do %><%= t(".title") %><% end -%>
<div class="flex overflow-hidden rounded-lg border border-slate-200 bg-white">
  <aside class="w-56 shrink-0 border-r border-slate-200 py-3">
    <% @sections.each do |section| %>
      <details class="group" <%= "open" if section[:open] %>>
        <summary class="flex cursor-pointer list-none items-center gap-1.5 px-3 py-2 text-sm hover:bg-slate-100 [&::-webkit-details-marker]:hidden">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
               class="size-3 shrink-0 text-slate-400 transition-transform group-open:rotate-90">
            <path d="M8 4l10 8-10 8V4Z" />
          </svg>
          <span class="truncate"><%= t(".sections.#{section[:key]}") %></span>
        </summary>

        <% section[:children].each do |child| %>
          <div class="flex items-center gap-2 py-1.5 pr-3 pl-8 text-sm hover:bg-slate-100">
            <%= render "partial/file_icon", folder: true %>
            <span class="truncate"><%= child %></span>
          </div>
        <% end %>
      </details>
    <% end %>
  </aside>

  <section class="min-w-0 flex-1 px-6 py-5">
    <div class="mb-6 flex items-center justify-between gap-4">
      <h1 class="text-lg font-bold"><%= t(".heading") %></h1>
      <button type="button"
              class="flex cursor-pointer items-center gap-1.5 rounded border border-slate-300 px-4 py-2 text-sm font-semibold hover:bg-slate-100">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4" aria-hidden="true">
          <path stroke-linecap="round" d="M12 5v14M5 12h14" />
        </svg>
        <%= t(".create") %>
      </button>
    </div>

    <table id="file-list" class="w-full">
      <thead>
        <tr class="border-b-2 border-slate-200 text-sm text-slate-500">
          <th class="px-3 py-2.5 text-left font-normal"><%= t(".columns.name") %></th>
          <th class="px-3 py-2.5 text-left font-normal"><%= t(".columns.owner") %></th>
          <th class="px-3 py-2.5 text-left font-normal"><%= t(".columns.updated_at") %></th>
          <th class="px-3 py-2.5 text-right font-normal"><%= t(".columns.size") %></th>
          <th class="w-10"></th>
        </tr>
      </thead>
      <tbody>
        <% @entries.each do |entry| %>
          <tr class="border-b border-slate-200 hover:bg-slate-50">
            <td class="px-3 py-2.5">
              <span class="flex items-center gap-2">
                <%= render "partial/file_icon", folder: entry.folder %>
                <span class="truncate"><%= entry.name %></span>
              </span>
            </td>
            <td class="px-3 py-2.5 text-sm"><%= entry.owner %></td>
            <td class="px-3 py-2.5 text-sm"><%= time_to_s(entry.updated_at) %></td>
            <td class="px-3 py-2.5 text-right text-sm">
              <%= entry.bytes ? number_to_human_size(entry.bytes) : "-" %>
            </td>
            <td class="py-2.5 pr-3">
              <details class="relative" data-dropdown>
                <summary class="flex cursor-pointer list-none justify-center rounded p-1 text-slate-500 hover:bg-slate-200 [&::-webkit-details-marker]:hidden"
                         aria-label="<%= t(".row_menu") %>">
                  <svg viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true">
                    <path d="M12 7a1.6 1.6 0 1 0 0-3.2A1.6 1.6 0 0 0 12 7Zm0 6.6a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2Zm0 6.6a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2Z" />
                  </svg>
                </summary>
                <div class="absolute right-0 z-10 mt-1 w-40 rounded-lg border border-slate-200 bg-white py-1 text-sm shadow-lg">
                  <% %i[download rename destroy].each do |action| %>
                    <span class="block px-4 py-2 text-slate-400"><%= t(".row_actions.#{action}") %></span>
                  <% end %>
                </div>
              </details>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
</div>
