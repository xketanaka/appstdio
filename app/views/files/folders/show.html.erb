<% content_for :title do %><%= t(".title") %><% end -%>
<div class="flex min-h-0 flex-1 flex-col md:flex-row">
  <details class="shrink-0 border-b border-slate-200 bg-slate-50 md:hidden">
    <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-semibold [&::-webkit-details-marker]:hidden">
      <%= t(".drives") %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           class="size-4 text-slate-400" aria-hidden="true">
        <path stroke-linecap="round" d="M6 9l6 6 6-6" />
      </svg>
    </summary>
    <div class="pb-2"><%= render "tree", sections: @sections %></div>
  </details>

  <aside class="hidden w-60 shrink-0 overflow-y-auto border-r border-slate-200 bg-slate-50 py-3 md:block">
    <div class="px-3 pb-2 text-lg font-bold"><%= t("menus.files") %></div>
    <%= render "tree", sections: @sections %>
  </aside>

  <section class="flex min-h-0 min-w-0 flex-1 flex-col">
    <div class="flex shrink-0 items-center justify-between gap-4 border-b border-slate-200 px-4 py-3 sm:px-6">
      <h1 class="truncate text-lg font-bold"><%= t(".heading") %></h1>
      <%= button_tag type: "button",
            class: "flex shrink-0 cursor-pointer items-center gap-1.5 rounded bg-blue-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-blue-700 sm:px-4" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4" aria-hidden="true">
          <path stroke-linecap="round" d="M12 5v14M5 12h14" />
        </svg>
        <%= t(".create") %>
      <% end %>
    </div>

    <div class="min-h-0 flex-1 overflow-auto">
      <table id="file-list" class="w-full">
        <thead class="sticky top-0 bg-slate-50 text-sm text-slate-500">
          <tr class="border-b border-slate-200">
            <th class="px-4 py-2 text-left font-normal sm:px-6"><%= t(".columns.name") %></th>
            <th class="hidden px-3 py-2 text-left font-normal lg:table-cell"><%= t(".columns.owner") %></th>
            <th class="hidden px-3 py-2 text-left font-normal md:table-cell"><%= t(".columns.updated_at") %></th>
            <th class="hidden px-3 py-2 text-right font-normal sm:table-cell"><%= t(".columns.size") %></th>
            <th class="w-10"></th>
          </tr>
        </thead>
        <tbody>
          <% @entries.each do |entry| %>
            <tr class="border-b border-slate-100 hover:bg-blue-50/60">
              <td class="px-4 py-2.5 sm:px-6">
                <span class="flex items-center gap-2">
                  <%= render "partial/file_icon", folder: entry.folder %>
                  <span class="truncate"><%= entry.name %></span>
                </span>
                <span class="mt-0.5 block pl-7 text-xs text-slate-500 lg:hidden">
                  <span class="sm:hidden">
                    <span class="inline-block min-w-[4ch]"><%= entry.bytes ? number_to_human_size(entry.bytes) : "-" %></span>・</span>
                  <span class="md:hidden"><%= time_to_s(entry.updated_at) %>・</span>
                  <%= entry.owner %>
                </span>
              </td>
              <td class="hidden px-3 py-2.5 text-sm lg:table-cell"><%= entry.owner %></td>
              <td class="hidden px-3 py-2.5 text-sm md:table-cell"><%= time_to_s(entry.updated_at) %></td>
              <td class="hidden px-3 py-2.5 text-right text-sm sm:table-cell">
                <%= entry.bytes ? number_to_human_size(entry.bytes) : "-" %>
              </td>
              <td class="py-2.5 pr-2 sm:pr-4">
                <details class="relative" data-dropdown>
                  <summary class="flex cursor-pointer list-none justify-center rounded p-1 text-slate-500 hover:bg-slate-200 [&::-webkit-details-marker]:hidden"
                           aria-label="<%= t(".row_menu") %>">
                    <svg viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true">
                      <path d="M12 7a1.6 1.6 0 1 0 0-3.2A1.6 1.6 0 0 0 12 7Zm0 6.6a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2Zm0 6.6a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2Z" />
                    </svg>
                  </summary>
                  <div class="absolute right-0 z-10 mt-1 w-40 rounded-lg border border-slate-200 bg-white py-1 text-sm shadow-lg">
                    <% %i[download rename destroy].each do |action| %>
                      <span class="block px-4 py-2 text-slate-400"><%= t(".row_actions.#{action}") %></span>
                    <% end %>
                  </div>
                </details>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
