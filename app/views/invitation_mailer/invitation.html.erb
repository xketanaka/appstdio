<p><%= t(".body", inviter: @inviter_name, target: @target) %></p>
<% if @new_account %>
  <p><%= t(".new_account") %><br><%= link_to @url, @url %></p>
  <p><%= t(".expires", time: time_to_s(@expires_at)) %><br><%= t(".ignore") %></p>
<% else %>
  <p><%= t(".existing_account", tenant: @tenant_name) %><br><%= link_to @url, @url %></p>
  <p><%= t(".ignore") %></p>
<% end %>
