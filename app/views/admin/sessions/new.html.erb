<% content_for :title do %><%= t(".title") %><% end -%>
<div class="mx-auto my-12 max-w-md rounded-lg border border-slate-200 bg-white px-8 pt-6 pb-8">
  <h1 class="mb-6 text-xl font-bold"><%= t(".heading") %></h1>

  <%= form_with url: admin_login_path, method: :post do |f| %>
    <div class="mb-5">
      <%= f.label :email, User.human_attribute_name(:email), class: "mb-1.5 block text-sm font-semibold" %>
      <%= f.email_field :email, value: params[:email], autofocus: true,
            autocomplete: "username", class: "block w-full rounded border border-slate-300 px-3 py-2 focus:border-blue-600 focus:outline-2 focus:outline-blue-600/25" %>
    </div>

    <div class="mb-5">
      <%= f.label :password, User.human_attribute_name(:password), class: "mb-1.5 block text-sm font-semibold" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "block w-full rounded border border-slate-300 px-3 py-2 focus:border-blue-600 focus:outline-2 focus:outline-blue-600/25" %>
    </div>

    <%= f.submit t("actions.login"), class: "w-full cursor-pointer rounded bg-blue-600 px-5 py-2 font-semibold text-white hover:bg-blue-700" %>
  <% end %>
</div>
