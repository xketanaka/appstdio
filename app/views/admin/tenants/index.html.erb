<% content_for :title do %><%= t(".title") %><% end -%>
<div class="flex min-h-0 flex-1 flex-col">
  <div class="shrink-0 border-b border-slate-200 px-4 py-3 sm:px-6">
    <h1 class="text-lg font-bold"><%= t(".heading") %></h1>
  </div>

  <div class="min-h-0 flex-1 overflow-auto">
    <% if @tenants.empty? %>
      <p class="px-4 py-6 text-slate-500 sm:px-6"><%= t("messages.not_search_result") %></p>
    <% else %>
      <table id="tenant-table" class="w-full">
        <thead class="sticky top-0 bg-slate-50 text-sm text-slate-500">
          <tr class="border-b border-slate-200">
            <th class="px-4 py-2 text-left font-normal sm:px-6"><%= Tenant.human_attribute_name(:name) %></th>
            <th class="px-3 py-2 text-left font-normal"><%= Tenant.human_attribute_name(:status) %></th>
            <th class="px-3 py-2 text-right font-normal"><%= t(".members_count") %></th>
            <th class="hidden px-3 py-2 text-left font-normal sm:table-cell"><%= Tenant.human_attribute_name(:created_at) %></th>
          </tr>
        </thead>
        <tbody>
          <% @tenants.each do |tenant| %>
            <tr class="border-b border-slate-100 hover:bg-blue-50/60">
              <td class="px-4 py-2.5 sm:px-6"><span class="block truncate"><%= tenant.name %></span></td>
              <td class="px-3 py-2.5"><%= t("enums.tenant.status.#{tenant.status}") %></td>
              <td class="px-3 py-2.5 text-right"><%= tenant.members_count %></td>
              <td class="hidden px-3 py-2.5 sm:table-cell"><%= time_to_s(tenant.created_at) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
