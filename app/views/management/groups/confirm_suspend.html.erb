<% content_for :title do %><%= t(".title", name: @group.name) %><% end -%>
<% content_for :group_main do %>
  <h2 class="mb-5 text-sm text-slate-500"><%= t(".detail") %></h2>

  <div id="suspend-confirmation" class="text-sm">
    <p class="mb-3"><%= t(".message", name: @group.name) %></p>
    <% if @descendants_count.positive? %>
      <p class="mb-3"><%= t(".descendants", count: @descendants_count) %></p>
    <% end %>
    <ul class="mb-6 list-disc pl-5 text-slate-600">
      <li><%= t(".notes.hidden") %></li>
      <% if @files_enabled %>
        <li id="files-note"><%= t(".notes.shares") %></li>
      <% end %>
      <li><%= t(".notes.reactivate") %></li>
    </ul>
  </div>

  <div class="flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-slate-200 pt-4">
    <%= button_to t(".submit"), suspend_management_group_path(@group), class: "btn btn-primary" %>
    <%= link_to t(".cancel"), edit_management_group_path(@group), class: "text-sm whitespace-nowrap text-slate-600 hover:underline" %>
  </div>
<% end %>
<%= render "frame" %>
