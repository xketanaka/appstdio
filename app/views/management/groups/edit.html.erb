<% content_for :title do %><%= t(".title", name: @group.name_in_database) %><% end -%>
<% content_for :group_main do %>
  <h2 class="mb-5 text-sm text-slate-500"><%= t(".detail") %></h2>

  <%= render "partial/errors", object: @group %>

  <%= form_with model: @group, url: management_group_path(@group), id: "group-form" do |f| %>
    <div class="mb-5">
      <%= f.label :name, t(".name"), class: "mb-1.5 block text-sm font-semibold" %>
      <%= f.text_field :name, class: "input" %>
    </div>

    <%= render "parent_field", form: f %>

    <%= render "labels_field", form: f %>

    <%= tag.group_members data: { candidates_url: member_candidates_management_group_path(@group),
                                  count_text: t(".members.heading", count: "%{count}"),
                                  load_error: t(".members.dialog.load_error") } do %>
      <section id="direct-members" class="mb-6">
        <div class="mb-2 flex items-center justify-between gap-4">
          <h3 class="text-sm font-semibold" data-count><%= t(".members.heading", count: @members.size) %></h3>
          <%= button_tag t(".members.add"), type: "button", id: "add-members", data: { open_dialog: true },
                class: "btn btn-secondary btn-sm" %>
        </div>
        <p class="border-t border-slate-200 py-4 text-sm text-slate-500" data-empty <%= "hidden" if @members.any? %>><%= t(".members.empty") %></p>
        <table class="w-full" <%= "hidden" if @members.empty? %>>
          <tbody data-rows>
            <% @members.each do |member| %>
              <%= render "member_row", tenant_user_id: member.tenant_user_id, name: member.tenant_user.display_name,
                    email: member.tenant_user.user.email, leader: member.leader? %>
            <% end %>
          </tbody>
        </table>
        <template data-row-template><%= render "member_row" %></template>
      </section>

      <dialog id="member-dialog" aria-labelledby="member-dialog-title"
              class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl bg-white p-6 text-slate-800 shadow-xl backdrop:bg-slate-900/40">
        <h2 id="member-dialog-title" class="text-lg font-medium"><%= t(".members.dialog.title") %></h2>
        <label for="member-search" class="sr-only"><%= t(".members.dialog.search") %></label>
        <input type="search" id="member-search" autocomplete="off" data-search
               placeholder="<%= t(".members.dialog.search") %>" class="input mt-4">
        <ul class="mt-3 h-80 overflow-y-auto" data-candidates aria-label="<%= t(".members.dialog.candidates") %>"></ul>
        <div class="mt-6 flex justify-end gap-2">
          <%= button_tag t(".members.dialog.cancel"), type: "button", data: { close_dialog: true }, class: "btn btn-secondary" %>
          <%= button_tag t(".members.dialog.submit"), type: "button", data: { add_members: true }, class: "btn btn-primary" %>
        </div>
      </dialog>
    <% end %>

    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 border-t border-slate-200 pt-4">
      <div class="flex items-center gap-4">
        <%= f.submit t("actions.save"), class: "btn btn-primary" %>
        <%= link_to t(".cancel"), management_group_path(@group), class: "text-sm whitespace-nowrap text-slate-600 hover:underline" %>
      </div>
      <%= button_tag t(".destroy"), type: "button",
            class: "btn btn-danger" %>
    </div>
  <% end %>
<% end %>
<%= render "frame" %>
