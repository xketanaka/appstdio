<% content_for :title do %><%= t(".title", name: @group.name_in_database) %><% end -%>
<% content_for :group_main do %>
  <h2 class="mb-5 text-sm text-slate-500"><%= t(".detail") %></h2>

  <%= render "partial/errors", object: @group %>

  <%= form_with model: @group, url: management_group_path(@group), id: "group-form" do |f| %>
    <div class="mb-5">
      <%= f.label :name, t(".name"), class: "mb-1.5 block text-sm font-semibold" %>
      <%= f.text_field :name, class: "input" %>
    </div>

    <%= render "parent_field", form: f %>

    <%= render "labels_field", form: f %>

    <section id="direct-members" class="mb-6">
      <div class="mb-2 flex items-center justify-between gap-4">
        <h3 class="text-sm font-semibold"><%= t(".members.heading", count: @members.size) %></h3>
        <%= button_tag t(".members.add"), type: "button",
              class: "btn btn-secondary btn-sm" %>
      </div>
      <% if @members.empty? %>
        <p class="border-t border-slate-200 py-4 text-sm text-slate-500"><%= t(".members.empty") %></p>
      <% else %>
        <table class="w-full">
          <tbody>
            <% @members.each do |member| %>
              <tr class="border-t border-slate-200">
                <td class="py-2 pr-3">
                  <span class="block truncate"><%= member.tenant_user.display_name %></span>
                  <span class="block truncate text-xs text-slate-500"><%= member.tenant_user.user.email %></span>
                </td>
                <td class="w-px py-2 pr-2 whitespace-nowrap">
                  <label class="flex items-center gap-1.5 text-sm text-slate-600">
                    <%= check_box_tag "leaders[]", member.tenant_user_id, member.leader?, id: "leader_#{member.tenant_user_id}", class: "accent-primary-600" %>
                    <%= t(".members.leader") %>
                  </label>
                </td>
                <td class="w-px py-2 text-right whitespace-nowrap">
                  <%= button_tag t(".members.remove"), type: "button",
                        class: "cursor-pointer rounded-full px-3 py-1 text-sm text-slate-500 hover:bg-slate-900/5" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </section>

    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 border-t border-slate-200 pt-4">
      <div class="flex items-center gap-4">
        <%= f.submit t("actions.save"), class: "btn btn-primary" %>
        <%= link_to t(".cancel"), management_group_path(@group), class: "text-sm whitespace-nowrap text-slate-600 hover:underline" %>
      </div>
      <%= button_tag t(".destroy"), type: "button",
            class: "btn btn-danger" %>
    </div>
  <% end %>
<% end %>
<%= render "frame" %>
