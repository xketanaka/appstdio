<div id="group-detail">
  <section id="direct-members" class="mb-8">
    <div class="mb-1 flex min-h-8 items-center">
      <h3 class="text-sm font-semibold"><%= t(".members.heading", count: @members.size) %></h3>
    </div>
    <% if @members.empty? %>
      <p class="border-t border-slate-200 py-4 text-sm text-slate-500"><%= t(".members.empty") %></p>
    <% else %>
      <table class="w-full">
        <tbody>
          <% @members.each do |member| %>
            <tr class="border-t border-slate-200">
              <td class="py-2">
                <span class="flex items-center gap-2">
                  <span class="truncate"><%= member.tenant_user.display_name %></span>
                  <% if member.leader? %>
                    <span class="shrink-0 rounded-full bg-primary-50 px-2 py-0.5 text-xs font-medium text-primary-700"><%= t(".members.leader") %></span>
                  <% end %>
                </span>
                <span class="block truncate text-xs text-slate-500"><%= member.tenant_user.user.email %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>

  <% if @has_children %>
    <details id="sub-members" class="group mb-8">
      <summary class="mb-1 flex min-h-8 cursor-pointer list-none items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
        <h3 class="text-sm font-semibold"><%= t(".sub_members.heading", count: @sub_members_count) %></h3>
        <span class="btn btn-secondary btn-sm shrink-0">
          <span class="group-open:hidden"><%= t(".sub_members.show") %></span>
          <span class="hidden group-open:inline"><%= t(".sub_members.hide") %></span>
        </span>
      </summary>
      <% if @sub_members_count.zero? %>
        <p class="border-t border-slate-200 py-4 text-sm text-slate-500"><%= t(".sub_members.empty") %></p>
      <% else %>
        <%# 開くと data-load-more の行が見えるようになり、そこで初めて1ページ目を読み込む %>
        <ul id="sub-member-list">
          <%= render "load_more", url: sub_members_management_group_path(@group, page: 1) %>
        </ul>
      <% end %>
    </details>
  <% end %>
</div>
