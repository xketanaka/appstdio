<div id="group-detail">
  <div class="mb-5">
    <%= label_tag :group_name, t(".fields.name"), class: "mb-1.5 block text-sm font-semibold" %>
    <%= text_field_tag :group_name, @group.name,
          class: "block w-full rounded border border-slate-300 px-3 py-2 focus:border-blue-600 focus:outline-2 focus:outline-blue-600/25" %>
  </div>

  <details id="group-parent" class="group mb-6">
    <summary class="list-none [&::-webkit-details-marker]:hidden">
      <span class="mb-1.5 block text-sm font-semibold"><%= t(".fields.parent") %></span>
      <span class="flex items-center justify-between gap-4">
        <span class="min-w-0 truncate">
          <% if @parent_path.empty? %>
            <span class="text-slate-500"><%= t(".no_parent") %></span>
          <% else %>
            <% @parent_path.each_with_index do |group, i| %>
              <% if i.positive? %><span class="mx-1 text-slate-400" aria-hidden="true">&gt;</span><% end %>
              <span><%= group.name %></span>
            <% end %>
          <% end %>
        </span>
        <span class="shrink-0 cursor-pointer rounded border border-slate-300 px-3 py-1 text-sm hover:bg-slate-100 group-open:hidden"><%= t(".change") %></span>
      </span>
    </summary>
    <%= label_tag :group_parent_id, t(".fields.parent"), class: "sr-only" %>
    <%= select_tag :group_parent_id,
          options_for_select(@parent_options, @group.parent_id),
          include_blank: t(".no_parent"),
          class: "mt-2 block w-full rounded border border-slate-300 bg-white px-3 py-2 focus:border-blue-600 focus:outline-2 focus:outline-blue-600/25" %>
  </details>

  <p class="mb-3 text-sm text-slate-500"><%= t(".total", count: @total_count) %></p>

  <section id="direct-members" class="mb-6">
    <div class="mb-2 flex items-center justify-between gap-4">
      <h3 class="text-sm font-semibold"><%= t(".members.heading", count: @members.size) %></h3>
      <%= button_tag t(".members.add"), type: "button",
            class: "shrink-0 cursor-pointer rounded border border-slate-300 px-3 py-1 text-sm hover:bg-slate-100" %>
    </div>
    <% if @members.empty? %>
      <p class="border-t border-slate-200 py-4 text-sm text-slate-500"><%= t(".members.empty") %></p>
    <% else %>
      <table class="w-full">
        <tbody>
          <% @members.each do |member| %>
            <tr class="border-t border-slate-200">
              <td class="py-2 pr-3">
                <span class="block truncate"><%= member.display_name %></span>
                <span class="block truncate text-xs text-slate-500"><%= member.email %></span>
              </td>
              <td class="w-px py-2 text-right whitespace-nowrap">
                <%= button_tag t(".members.remove"), type: "button",
                      class: "cursor-pointer rounded px-2 py-1 text-sm text-slate-500 hover:bg-slate-100" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>

  <% if @children.key?(@group.id) %>
    <section id="sub-members" class="mb-6">
      <h3 class="mb-2 text-sm font-semibold"><%= t(".sub_members.heading", count: @sub_members.size) %></h3>
      <% if @sub_members.empty? %>
        <p class="border-t border-slate-200 py-4 text-sm text-slate-500"><%= t(".sub_members.empty") %></p>
      <% else %>
        <table class="w-full">
          <tbody>
            <% @sub_members.each do |member, groups| %>
              <tr class="border-t border-slate-200">
                <td class="py-2 pr-3">
                  <span class="block truncate"><%= member.display_name %></span>
                  <span class="block truncate text-xs text-slate-500"><%= member.email %></span>
                </td>
                <td class="py-2 text-right text-sm">
                  <% groups.each do |group| %>
                    <%= link_to group.name, management_group_path(group), class: "ml-2 inline-block text-blue-700 hover:underline" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </section>
  <% end %>

  <div class="flex items-center justify-between gap-4 border-t border-slate-200 pt-4">
    <%= button_tag t("actions.save"), type: "button",
          class: "cursor-pointer rounded bg-blue-600 px-5 py-2 font-semibold text-white hover:bg-blue-700" %>
    <%= button_tag t(".destroy"), type: "button",
          class: "cursor-pointer rounded border border-red-300 px-4 py-2 text-sm text-red-700 hover:bg-red-50" %>
  </div>
</div>
