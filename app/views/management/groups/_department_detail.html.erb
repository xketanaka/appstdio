<div id="group-detail">
  <dl class="mb-6 grid gap-x-4 gap-y-1 sm:grid-cols-[8rem_1fr] sm:gap-y-3">
    <dt class="text-sm text-slate-500"><%= t(".fields.name") %></dt>
    <dd class="mb-2 sm:mb-0"><%= @group.name %></dd>

    <dt class="text-sm text-slate-500"><%= t(".fields.parent") %></dt>
    <dd id="group-parent-path" class="mb-2 sm:mb-0">
      <% if @parent_path.empty? %>
        <span class="text-slate-500"><%= t(".no_parent") %></span>
      <% else %>
        <% @parent_path.each_with_index do |group, i| %>
          <% if i.positive? %><span class="mx-1 text-slate-400" aria-hidden="true">&gt;</span><% end %>
          <%= link_to group.name, management_group_path(group), class: "text-primary-700 hover:underline" %>
        <% end %>
      <% end %>
    </dd>
  </dl>

  <section id="direct-members" class="mb-6">
    <h3 class="mb-2 text-sm font-semibold"><%= t(".members.heading", count: @members.size) %></h3>
    <% if @members.empty? %>
      <p class="border-t border-slate-200 py-4 text-sm text-slate-500"><%= t(".members.empty") %></p>
    <% else %>
      <table class="w-full">
        <tbody>
          <% @members.each do |member| %>
            <tr class="border-t border-slate-200">
              <td class="py-2">
                <span class="block truncate"><%= member.display_name %></span>
                <span class="block truncate text-xs text-slate-500"><%= member.email %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>

  <% if @children.key?(@group.id) %>
    <details id="sub-members" class="group mb-6">
      <summary class="flex cursor-pointer list-none items-center gap-1.5 text-sm font-semibold [&::-webkit-details-marker]:hidden">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
             class="size-3 shrink-0 text-slate-400 transition-transform group-open:rotate-90">
          <path d="M8 4l10 8-10 8V4Z" />
        </svg>
        <%= t(".sub_members.heading", count: @sub_members_count) %>
      </summary>
      <% if @sub_members_count.zero? %>
        <p class="mt-2 border-t border-slate-100 py-4 text-sm text-slate-500"><%= t(".sub_members.empty") %></p>
      <% else %>
        <%# 開くと data-load-more の行が見えるようになり、そこで初めて1ページ目を読み込む %>
        <ul id="sub-member-list" class="mt-2">
          <%= render "load_more", url: sub_members_management_group_path(@group, page: 1) %>
        </ul>
      <% end %>
    </details>
  <% end %>
</div>
