<% content_for :title do %><%= t(".title") %><% end -%>
<% content_for :group_main do %>
  <%= link_to t(".back"), management_groups_path, class: "mb-3 inline-block text-sm text-primary-700 hover:underline lg:hidden" %>
  <h2 class="mb-5 text-sm text-slate-500"><%= t(".detail") %></h2>

  <%= render "partial/errors", object: @group %>

  <%= form_with model: @group, url: management_groups_path, id: "group-form" do |f| %>
    <div class="mb-5">
      <%= f.label :name, t(".name"), class: "mb-1.5 block text-sm font-semibold" %>
      <%= f.text_field :name, autofocus: true, class: "input" %>
    </div>

    <%= render "parent_field", form: f %>

    <%= render "labels_field", form: f %>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-slate-200 pt-4">
      <%= f.submit t(".submit"), class: "btn btn-primary" %>
      <%= link_to t(".cancel"), (@group.parent ? management_group_path(@group.parent) : management_groups_path),
            class: "text-sm whitespace-nowrap text-slate-600 hover:underline" %>
    </div>
  <% end %>
<% end %>
<%= render "frame" %>
