<% if @candidates.empty? && @next_page.nil? && params[:page].to_i <= 1 %>
  <li class="py-3 text-center text-sm text-slate-500"><%= t(".empty") %></li>
<% end %>
<% @candidates.each do |tenant_user| %>
  <li class="border-t border-slate-100 first:border-t-0">
    <label class="flex cursor-pointer items-center gap-3 rounded-xl px-2 py-2 hover:bg-canvas has-disabled:cursor-default has-disabled:text-slate-400">
      <input type="checkbox" value="<%= tenant_user.id %>" class="accent-primary-600"
             data-name="<%= tenant_user.display_name %>" data-email="<%= tenant_user.user.email %>">
      <span class="min-w-0">
        <span class="block truncate"><%= tenant_user.display_name %></span>
        <span class="block truncate text-xs text-slate-500"><%= tenant_user.user.email %></span>
      </span>
      <% if tenant_user.invited? %>
        <span class="ml-auto shrink-0 rounded-full bg-amber-50 px-2 py-0.5 text-xs text-amber-800"><%= t(".invited") %></span>
      <% end %>
    </label>
  </li>
<% end %>
<% if @next_page %>
  <%= render "load_more", url: member_candidates_management_group_path(@group, q: params[:q].presence, page: @next_page) %>
<% end %>
