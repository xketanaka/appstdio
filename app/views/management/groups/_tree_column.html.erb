<%# locals: (class_name:) %>
<div class="<%= class_names("min-h-0 overflow-y-auto px-2 py-3", class_name) %>">
  <nav id="group-tree" aria-label="<%= t(".label") %>">
    <%# グループ管理者には「全員」を出さない（範囲の外） %>
    <% if @everyone %>
      <% current = @group&.id == @everyone.id %>
      <div id="everyone-group" class="flex items-center">
        <%= link_to @everyone.name, management_group_path(@everyone),
              "aria-current": (current ? "page" : nil),
              class: class_names("nav-item w-full truncate pl-7", "nav-item-current": current) %>
      </div>
    <% end %>
    <%= render "tree", parent_id: nil %>
    <%# プロジェクトのグループは部署の後ろに「プロジェクト」の下にまとめて出す。グループ管理者には「プロジェクト」
        そのものは範囲の外なので、名前だけを出す。プロジェクトの追加はプロジェクト管理で行うので「＋」は無い %>
    <% if @project_root || @projects.any? %>
      <details id="project-groups" class="group" open>
        <% current = @project_root && @group&.id == @project_root.id %>
        <summary class="<%= class_names("nav-item cursor-pointer list-none pr-1.5 pl-2.5 [&::-webkit-details-marker]:hidden", "nav-item-current": current) %>">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
               class="size-3 shrink-0 text-slate-400 transition-transform group-open:rotate-90">
            <path d="M8 4l10 8-10 8V4Z" />
          </svg>
          <% if @project_root %>
            <%= link_to @project_root.name, management_group_path(@project_root),
                  "aria-current": (current ? "page" : nil), class: "min-w-0 truncate" %>
          <% else %>
            <span class="min-w-0 truncate"><%= t("groups.project_root") %></span>
          <% end %>
        </summary>
        <div class="pl-4">
          <% @projects.each do |project| %>
            <% current = @group&.id == project.id %>
            <div class="<%= class_names("nav-item pr-1.5 pl-7", "nav-item-current": current) %>">
              <%= link_to project.name, management_group_path(project),
                    "aria-current": (current ? "page" : nil), class: "min-w-0 truncate" %>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>
  </nav>

  <% if @scope.can_place_under?(nil) %>
    <%= link_to new_management_group_path, id: "new-group", class: "nav-item mt-1 pl-2 text-slate-500 hover:text-slate-800" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4 shrink-0" aria-hidden="true">
        <path stroke-linecap="round" d="M12 5v14M5 12h14" />
      </svg>
      <%= t(".create") %>
    <% end %>
  <% end %>

  <%= link_to t(".suspended"), suspended_management_groups_path, id: "suspended-groups-link",
        class: "mt-4 block px-3 text-sm text-primary-700 hover:underline" %>
</div>
