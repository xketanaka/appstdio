<% content_for :title do %><%= t(".title", name: @group.name) %><% end -%>
<% content_for :group_main do %>
  <h2 class="mb-1 text-sm text-slate-500"><%= t(".detail") %></h2>
  <p class="mb-5 text-lg"><%= @group.name %></p>

  <%= render "partial/errors", object: @group %>

  <%= form_with url: update_members_management_group_path(@group), method: :patch, id: "members-form" do %>
    <%= render "members_field", group: @group, members: @members %>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-slate-200 pt-4">
      <%= submit_tag t("actions.save"), class: "btn btn-primary" %>
      <%= link_to t(".cancel"), management_group_path(@group), class: "text-sm whitespace-nowrap text-slate-600 hover:underline" %>
    </div>
  <% end %>
<% end %>
<%= render "frame" %>
