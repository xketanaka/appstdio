<% content_for :title do %><%= t(".title") %><% end -%>
<div class="min-h-0 flex-1 overflow-y-auto">
  <div class="mx-auto w-full max-w-3xl px-4 py-6 sm:px-6 sm:py-8">
    <h1 class="mb-6 text-title"><%= t(".heading") %></h1>

    <%= render "partial/errors", object: @setting %>
    <%= render "partial/errors", object: @files_setting %>

    <%= form_with model: @setting, url: management_tenant_setting_path, method: :patch, id: "tenant-setting-form" do |f| %>
      <h2 class="mb-3 text-sm font-semibold text-slate-500"><%= t(".sections.appearance") %></h2>

      <div class="mb-5">
        <%= f.label :title_label, class: "mb-1.5 block text-sm font-semibold" %>
        <%= f.text_field :title_label, placeholder: Settings.system_title, class: "input" %>
        <p class="mt-1 text-xs text-slate-500"><%= t(".hints.title_label", title: Settings.system_title) %></p>
      </div>

      <div class="mb-5">
        <%= f.label :title_color, class: "mb-1.5 block text-sm font-semibold" %>
        <div class="flex flex-wrap items-center gap-4">
          <%= f.color_field :title_color, value: @setting.title_color || TenantSetting::DEFAULT_TITLE_COLOR,
                class: "h-10 w-16 cursor-pointer rounded-xl border border-slate-300 bg-white p-1" %>
          <label class="flex items-center gap-2 text-sm">
            <%= check_box_tag :use_default_color, "1", @setting.title_color.nil?, class: "accent-primary-600" %>
            <%= t(".use_default_color") %>
          </label>
        </div>
        <p class="mt-1 text-xs text-slate-500"><%= t(".hints.title_color") %></p>
      </div>

      <div class="mb-8">
        <%= f.label :logo, class: "mb-1.5 block text-sm font-semibold" %>
        <% if @setting.logo.attached? && !@setting.attachment_changes.key?("logo") %>
          <div class="mb-2 flex items-center gap-4">
            <%= image_tag @setting.logo, alt: TenantSetting.human_attribute_name(:logo),
                  class: "h-10 w-auto rounded-lg border border-slate-200 bg-canvas p-1" %>
            <label class="flex items-center gap-2 text-sm">
              <%= check_box_tag :remove_logo, "1", false, class: "accent-primary-600" %>
              <%= t(".remove_logo") %>
            </label>
          </div>
        <% end %>
        <%= f.file_field :logo, accept: TenantSetting::LOGO_CONTENT_TYPES.join(","),
              class: "block w-full text-sm file:mr-3 file:cursor-pointer file:rounded-full file:border-0 file:bg-white file:px-4 file:py-1.5 file:text-sm file:font-medium file:text-primary-700 file:ring-1 file:ring-slate-300 file:ring-inset hover:file:bg-primary-50" %>
        <p class="mt-1 text-xs text-slate-500"><%= t(".hints.logo", size: TenantSetting::LOGO_MAX_BYTES / 1.megabyte) %></p>
      </div>

      <h2 class="mb-3 border-t border-slate-200 pt-6 text-sm font-semibold text-slate-500"><%= t(".sections.features") %></h2>

      <div class="mb-8">
        <label class="flex items-center gap-2">
          <%= check_box_tag :files_enabled, "1", @files_setting.enabled?, class: "accent-primary-600" %>
          <%= t(".files_enabled") %>
        </label>
        <p class="mt-1 text-xs text-slate-500"><%= t(".hints.files_enabled") %></p>
      </div>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-slate-200 pt-4">
        <%= f.submit t("actions.save"), class: "btn btn-primary" %>
        <%= link_to t(".cancel"), management_tenant_setting_path, class: "text-sm whitespace-nowrap text-slate-600 hover:underline" %>
      </div>
    <% end %>
  </div>
</div>
