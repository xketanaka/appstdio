<%# locals: (form:, roles:) %>
<%# 追加と編集に共通の欄。選べるものが1つしかない権限は、変えられないので文字で出す %>
<div class="mb-5">
  <%= form.label :display_name, class: "mb-1.5 block text-sm font-semibold" %>
  <%= form.text_field :display_name, autocomplete: "off", class: "input" %>
</div>

<%= render "management/labels_field", form:, suggestions: TenantUserLabel.order(:name).pluck(:name) %>

<fieldset id="role-choices" class="mb-5">
  <legend class="mb-1.5 text-sm font-semibold"><%= TenantUser.human_attribute_name(:role) %></legend>
  <% if roles.one? %>
    <p class="text-sm"><%= t("enums.tenant_user.role.#{roles.first}") %></p>
  <% else %>
    <div class="flex flex-wrap gap-x-6 gap-y-2">
      <% roles.each do |value| %>
        <label class="flex items-center gap-2 text-sm">
          <%= form.radio_button :role, value, class: "accent-primary-600" %>
          <%= t("enums.tenant_user.role.#{value}") %>
        </label>
      <% end %>
    </div>
  <% end %>
</fieldset>

<%# 1つも選ばなかったときも group_ids を送る %>
<%= hidden_field_tag "tenant_user[group_ids][]", "", id: nil %>
<%= render "group_picker", key: :groups, groups: @groups %>
<% if current_tenant.setting.projects_enabled? %>
  <%= render "group_picker", key: :projects, groups: @projects %>
<% end %>
