<% content_for :title do %><%= t(".title") %><% end -%>
<h1 class="mb-6 text-lg font-bold"><%= t(".heading") %></h1>

<table id="user-list" class="w-full">
  <thead>
    <tr class="border-b-2 border-slate-200 text-sm text-slate-500">
      <th class="px-3 py-2.5 text-left font-normal"><%= TenantUser.human_attribute_name(:display_name) %></th>
      <th class="px-3 py-2.5 text-left font-normal"><%= User.human_attribute_name(:email) %></th>
      <th class="px-3 py-2.5 text-left font-normal"><%= TenantUser.human_attribute_name(:role) %></th>
      <th class="px-3 py-2.5 text-left font-normal"><%= TenantUser.human_attribute_name(:status) %></th>
    </tr>
  </thead>
  <tbody>
    <% @tenant_users.each do |tenant_user| %>
      <tr class="border-b border-slate-200 hover:bg-slate-50">
        <td class="px-3 py-2.5"><%= tenant_user.display_name %></td>
        <td class="px-3 py-2.5 text-sm"><%= tenant_user.user.email %></td>
        <td class="px-3 py-2.5 text-sm"><%= t("enums.tenant_user.role.#{tenant_user.role}") %></td>
        <td class="px-3 py-2.5 text-sm"><%= t("enums.tenant_user.status.#{tenant_user.status}") %></td>
      </tr>
    <% end %>
  </tbody>
</table>
