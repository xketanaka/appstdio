<% content_for :title do %><%= t(".title") %><% end -%>
<div class="shrink-0 px-6 pt-5 pb-3">
  <h1 class="truncate text-title"><%= t(".heading") %></h1>
</div>

<div class="min-h-0 flex-1 overflow-auto px-3">
  <table id="user-list" class="w-full">
    <thead class="sticky top-0 bg-white text-xs text-slate-500">
      <tr class="border-b border-slate-200">
        <th class="px-3 py-2.5 text-left font-medium"><%= TenantUser.human_attribute_name(:display_name) %></th>
        <th class="hidden px-3 py-2.5 text-left font-medium lg:table-cell"><%= User.human_attribute_name(:email) %></th>
        <th class="hidden px-3 py-2.5 text-left font-medium sm:table-cell"><%= TenantUser.human_attribute_name(:role) %></th>
        <th class="px-3 py-2.5 text-left font-medium"><%= TenantUser.human_attribute_name(:status) %></th>
      </tr>
    </thead>
    <tbody>
      <% @tenant_users.each do |tenant_user| %>
        <tr class="border-b border-slate-100 hover:bg-canvas">
          <td class="px-3 py-2.5">
            <%= link_to tenant_user.display_name, management_user_path(tenant_user),
                  class: "block truncate text-primary-700 hover:underline" %>
            <span class="mt-0.5 block text-xs text-slate-500 lg:hidden">
              <span class="sm:hidden"><%= t("enums.tenant_user.role.#{tenant_user.role}") %>・</span>
              <%= tenant_user.user.email %>
            </span>
          </td>
          <td class="hidden px-3 py-2.5 text-sm lg:table-cell"><%= tenant_user.user.email %></td>
          <td class="hidden px-3 py-2.5 text-sm sm:table-cell"><%= t("enums.tenant_user.role.#{tenant_user.role}") %></td>
          <td class="px-3 py-2.5 text-sm"><%= t("enums.tenant_user.status.#{tenant_user.status}") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
