<% content_for :title do %><%= t(".title") %><% end -%>
<div class="shrink-0 border-b border-slate-200 px-4 py-3">
  <h1 class="truncate text-lg font-bold"><%= t(".heading") %></h1>
</div>

<div class="min-h-0 flex-1 overflow-auto px-4">
  <table id="user-list" class="w-full">
    <thead class="sticky top-0 bg-slate-50 text-sm text-slate-500">
      <tr class="border-b border-slate-200">
        <th class="px-3 py-2 text-left font-normal"><%= TenantUser.human_attribute_name(:display_name) %></th>
        <th class="hidden px-3 py-2 text-left font-normal lg:table-cell"><%= User.human_attribute_name(:email) %></th>
        <th class="hidden px-3 py-2 text-left font-normal sm:table-cell"><%= TenantUser.human_attribute_name(:role) %></th>
        <th class="px-3 py-2 text-left font-normal"><%= TenantUser.human_attribute_name(:status) %></th>
      </tr>
    </thead>
    <tbody>
      <% @tenant_users.each do |tenant_user| %>
        <tr class="border-b border-slate-100 hover:bg-blue-50/60">
          <td class="px-3 py-2.5">
            <span class="block truncate"><%= tenant_user.display_name %></span>
            <span class="mt-0.5 block text-xs text-slate-500 lg:hidden">
              <span class="sm:hidden"><%= t("enums.tenant_user.role.#{tenant_user.role}") %>・</span>
              <%= tenant_user.user.email %>
            </span>
          </td>
          <td class="hidden px-3 py-2.5 text-sm lg:table-cell"><%= tenant_user.user.email %></td>
          <td class="hidden px-3 py-2.5 text-sm sm:table-cell"><%= t("enums.tenant_user.role.#{tenant_user.role}") %></td>
          <td class="px-3 py-2.5 text-sm"><%= t("enums.tenant_user.status.#{tenant_user.status}") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
