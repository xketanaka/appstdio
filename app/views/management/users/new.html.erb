<% content_for :title do %><%= t(".title") %><% end -%>
<div class="shrink-0 px-4 pt-5 pb-3 sm:px-6">
  <h1 class="truncate text-title"><%= t(".heading") %></h1>
</div>

<div class="min-h-0 flex-1 overflow-y-auto">
  <div class="w-full max-w-2xl px-4 py-4 sm:px-6">
    <%= link_to t(".back"), management_users_path, class: "mb-3 inline-block text-sm text-primary-700 hover:underline" %>
    <h2 class="mb-5 text-sm text-slate-500"><%= t(".detail") %></h2>

    <%= render "partial/errors", object: @tenant_user %>

    <%= form_with model: @tenant_user, url: management_users_path, id: "user-form" do |f| %>
      <div class="mb-5">
        <%= f.label :email, User.human_attribute_name(:email), class: "mb-1.5 block text-sm font-semibold" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "off", class: "input" %>
      </div>

      <div class="mb-5">
        <%= f.label :display_name, class: "mb-1.5 block text-sm font-semibold" %>
        <%= f.text_field :display_name, autocomplete: "off", class: "input" %>
      </div>

      <fieldset class="mb-5">
        <legend class="mb-1.5 text-sm font-semibold"><%= TenantUser.human_attribute_name(:role) %></legend>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          <% current_tenant_user.assignable_roles.each do |role| %>
            <label class="flex items-center gap-2 text-sm">
              <%= f.radio_button :role, role, class: "accent-primary-600" %>
              <%= t("enums.tenant_user.role.#{role}") %>
            </label>
          <% end %>
        </div>
      </fieldset>

      <fieldset id="group-choices" class="mb-6">
        <legend class="mb-1.5 text-sm font-semibold"><%= t(".groups.label") %></legend>
        <%# 1つも選ばなかったときも group_ids を送る %>
        <%= hidden_field_tag "tenant_user[group_ids][]", "", id: nil %>
        <% if @group_choices.empty? %>
          <p class="text-sm text-slate-500"><%= t(".groups.empty") %></p>
        <% else %>
          <ul class="max-h-72 overflow-y-auto rounded-xl border border-slate-200 py-1">
            <% @group_choices.each do |group, path| %>
              <li>
                <label class="flex items-start gap-2.5 px-3 py-1.5 hover:bg-canvas">
                  <%= check_box_tag "tenant_user[group_ids][]", group.id, @group_ids.include?(group.id),
                        id: "group_#{group.id}", class: "mt-1 accent-primary-600" %>
                  <span class="min-w-0">
                    <span class="block truncate text-sm"><%= group.name %></span>
                    <% if path.size > 1 %>
                      <span class="block truncate text-xs text-slate-500"><%= path[...-1].join(" > ") %></span>
                    <% end %>
                  </span>
                </label>
              </li>
            <% end %>
          </ul>
        <% end %>
      </fieldset>

      <p class="mb-4 text-sm text-slate-500"><%= t(".invited_note") %></p>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-slate-200 pt-4">
        <%= f.submit t(".submit"), class: "btn btn-primary" %>
        <%= link_to t(".cancel"), management_users_path, class: "text-sm whitespace-nowrap text-slate-600 hover:underline" %>
      </div>
    <% end %>
  </div>
</div>
