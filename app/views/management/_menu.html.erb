<%# PC とスマホの2箇所から描画される。id を持つ要素を置かないこと %>
<nav aria-label="<%= t(".label") %>">
  <% { users: management_users_path,
       groups: management_groups_path,
       tenants: management_tenants_path }.each do |key, path| %>
    <% current = controller_name == key.to_s %>
    <%= link_to t(".items.#{key}"), path,
          "aria-current": (current ? "page" : nil),
          class: class_names("mx-2 block rounded-md px-2 py-2 text-sm",
                             current ? "bg-primary-50 font-semibold text-primary-700" : "hover:bg-slate-100") %>
  <% end %>
</nav>
