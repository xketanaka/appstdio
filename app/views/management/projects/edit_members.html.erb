<% content_for :title do %><%= t(".title", name: @project.name) %><% end -%>
<div class="shrink-0 px-4 pt-5 pb-3 sm:px-6">
  <h1 class="truncate text-title"><%= t(".heading") %></h1>
</div>

<div class="min-h-0 flex-1 overflow-y-auto">
  <div class="w-full max-w-2xl px-4 py-4 sm:px-6">
    <h2 class="mb-1 text-sm text-slate-500"><%= t(".detail") %></h2>
    <p class="mb-5 text-lg"><%= @project.name %></p>

    <%= render "partial/errors", object: @project.group %>

    <%= form_with url: update_members_management_project_path(@project), method: :patch, id: "members-form" do %>
      <%= render "management/groups/members_field", group: @project.group, members: @members %>
      <p class="mb-4 text-sm text-slate-500"><%= t(".leader_note") %></p>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-slate-200 pt-4">
        <%= submit_tag t("actions.save"), class: "btn btn-primary" %>
        <%= link_to t(".cancel"), management_project_path(@project), class: "text-sm whitespace-nowrap text-slate-600 hover:underline" %>
      </div>
    <% end %>
  </div>
</div>
