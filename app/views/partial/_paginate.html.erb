<ul class="flex items-center gap-1 text-sm">
  <li>
    <%- if paginator.has_prev? -%>
    <%= link_to page_url(form, paginator.page - 1), class: "block rounded px-3 py-1.5 hover:bg-slate-200" do %><%= t(".previous") %><% end %>
    <%- else -%>
    <span class="block px-3 py-1.5 text-slate-400"><%= t(".previous") %></span>
    <%- end -%>
  </li>
  <% paginator.nearly_range.each do |i| %>
  <li>
    <%- if paginator.linkable?(i) -%>
    <%= link_to page_url(form, i), class: "block rounded px-3 py-1.5 hover:bg-slate-200" do %><%= i %><% end %>
    <%- else -%>
    <span class="block rounded px-3 py-1.5 <%= "bg-slate-800 text-white" if i == paginator.page %>"><%= i %></span>
    <%- end -%>
  </li>
  <% end %>
  <li>
    <%- if paginator.has_next? -%>
    <%= link_to page_url(form, paginator.page + 1), class: "block rounded px-3 py-1.5 hover:bg-slate-200" do %><%= t(".next") %><% end %>
    <%- else -%>
    <span class="block px-3 py-1.5 text-slate-400"><%= t(".next") %></span>
    <%- end -%>
  </li>
</ul>
