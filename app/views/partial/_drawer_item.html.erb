<% if path %>
  <%= link_to label, path, class: "mx-2 block rounded-md px-3 py-2 hover:bg-slate-100" %>
<% else %>
  <span class="mx-2 flex items-center justify-between px-3 py-2 text-slate-400" aria-disabled="true">
    <%= label %>
    <span class="rounded-md bg-slate-100 px-1.5 py-0.5 text-xs"><%= t(".coming_soon") %></span>
  </span>
<% end %>
