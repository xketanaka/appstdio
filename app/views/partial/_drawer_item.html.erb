<% if path %>
  <%= link_to label, path, class: ui_nav_item_class(false) %>
<% else %>
  <span class="flex items-center justify-between px-4 py-2 text-sm text-slate-400" aria-disabled="true">
    <%= label %>
    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs"><%= t(".coming_soon") %></span>
  </span>
<% end %>
