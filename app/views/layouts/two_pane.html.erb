<%# :pane は PC とスマホの2箇所に出る。中に id を持つ要素を置かないこと %>
<% content_for :content do %>
  <div class="flex min-h-0 flex-1 flex-col">
    <%= yield :banner %>
    <div class="flex min-h-0 flex-1 flex-col md:flex-row">
      <details class="mx-2 mb-2 shrink-0 md:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between rounded-full px-4 py-2 text-sm font-semibold hover:bg-slate-900/5 [&::-webkit-details-marker]:hidden">
          <%= yield :pane_summary %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
               class="size-4 text-slate-400" aria-hidden="true">
            <path stroke-linecap="round" d="M6 9l6 6 6-6" />
          </svg>
        </summary>
        <div class="pt-1 pb-2"><%= yield :pane %></div>
      </details>

      <aside id="side-pane" class="hidden w-64 shrink-0 overflow-y-auto px-3 pb-4 md:block">
        <div class="px-4 pt-1 pb-3 text-lg font-medium"><%= yield :pane_title %></div>
        <%= yield :pane %>
      </aside>

      <section class="mx-2 mb-2 flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden rounded-2xl bg-white md:mr-4 md:mb-4 md:ml-0"><%= yield %></section>
    </div>
  </div>
<% end %>
<%= render template: "layouts/application" %>
