<% content_for :pane_title, t("menus.files") %>
<% content_for :pane_summary, t("files.sections.#{@section}") %>
<% content_for :pane do %>
  <%= render "files/tree" %>
  <%= render "files/privileged_mode" %>
<% end %>
<% if privileged_mode? %>
  <% content_for :banner do %>
    <div role="status" class="mx-2 mb-2 flex shrink-0 items-center justify-between gap-4 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-2 text-sm text-amber-900 md:mx-4">
      <span><%= t("files.privileged_mode.active") %></span>
      <%= button_to t("files.privileged_mode.leave"), files_privileged_mode_path, method: :delete,
            class: "shrink-0 cursor-pointer rounded-full bg-white px-4 py-1 font-medium ring-1 ring-amber-300 ring-inset hover:bg-amber-100" %>
    </div>
  <% end %>
<% end %>
<%= render template: "layouts/two_pane" %>
