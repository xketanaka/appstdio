<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || Settings.system_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="AppStdio">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>

    <link rel="icon" href="/favicon.ico" >

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-slate-50 leading-relaxed text-slate-800">
    <header class="flex items-center justify-between gap-4 bg-slate-800 px-6 py-3 text-white">
      <div class="flex items-center gap-3">
        <% if logged_in? %>
          <button type="button" data-drawer-open aria-label="<%= t(".main_menu") %>"
                  class="-ml-2 cursor-pointer rounded p-2 hover:bg-slate-700">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 class="size-5" aria-hidden="true">
              <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        <% end %>
        <div class="font-bold"><%= Settings.system_title %></div>
      </div>
      <% if logged_in? %>
        <div class="flex items-center gap-3 text-sm">
          <% if current_tenant %>
            <span class="rounded-full bg-white/15 px-2.5 py-0.5"><%= current_tenant.name %></span>
          <% end %>
          <%= render layout: "partial/account_menu",
                locals: { label: t(".account_menu"),
                          name: current_tenant_user&.display_name || current_user&.email,
                          email: current_user&.email } do %>
            <%= link_to t("actions.profile"), profile_path,
                  class: "block px-4 py-2 hover:bg-slate-100" %>
            <% if current_tenant %>
              <%= link_to t("actions.switch_tenant"), select_tenant_path,
                    class: "block px-4 py-2 hover:bg-slate-100" %>
            <% end %>
            <%= button_to t("actions.logout"), logout_path, method: :delete,
                  class: "block w-full cursor-pointer px-4 py-2 text-left hover:bg-slate-100" %>
          <% end %>
        </div>
      <% end %>
    </header>

    <% if logged_in? %>
      <%= render layout: "partial/drawer" do %>
        <%= render "partial/drawer_item", label: t("menus.files"), path: nil %>
        <%= render "partial/drawer_item", label: t("menus.pages"), path: nil %>
        <%= render "partial/drawer_item", label: t("menus.chats"), path: nil %>
      <% end %>
    <% end %>

    <div class="mx-auto max-w-5xl px-4 py-8">
      <%= render "partial/messages" %>
      <%= yield %>
    </div>
  </body>
</html>
