<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || Settings.system_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="AppStdio">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>

    <link rel="icon" href="/favicon.ico" >

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-slate-50 leading-relaxed text-slate-800">
    <header class="flex flex-wrap items-center justify-between gap-4 bg-slate-800 px-6 py-3 text-white">
      <div class="font-bold"><%= Settings.system_title %></div>
      <% if logged_in? %>
        <div class="flex items-center gap-4 text-sm">
          <% if current_tenant %>
            <span class="rounded-full bg-white/15 px-2.5 py-0.5"><%= current_tenant.name %></span>
            <%= link_to t("actions.switch_tenant"), select_tenant_path,
                  class: "text-slate-300 underline-offset-2 hover:underline" %>
          <% end %>
          <span><%= current_tenant_user&.display_name || current_user&.email %></span>
          <%= button_to t("actions.logout"), logout_path, method: :delete,
                class: "cursor-pointer rounded border border-slate-500 px-3 py-1 hover:bg-slate-700" %>
        </div>
      <% end %>
    </header>

    <div class="mx-auto max-w-5xl px-4 py-8">
      <%= render "partial/messages" %>
      <%= yield %>
    </div>
  </body>
</html>
