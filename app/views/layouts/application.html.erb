<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || Settings.system_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="AppStdio">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>

    <link rel="icon" href="/favicon.ico" >

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "font-awesome.min" %>
    <%= stylesheet_link_tag "normalize" %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="app-header">
      <div class="app-header__brand"><%= Settings.system_title %></div>
      <% if logged_in? %>
        <div class="app-header__account">
          <% if current_tenant %>
            <span class="app-header__tenant"><%= current_tenant.name %></span>
            <%= link_to t("actions.switch_tenant"), select_tenant_path, class: "app-header__link" %>
          <% end %>
          <span class="app-header__name"><%= current_tenant_user&.display_name || current_user&.email %></span>
          <%= button_to t("actions.logout"), logout_path, method: :delete, class: "btn btn--plain" %>
        </div>
      <% end %>
    </header>

    <div class="content">
      <%= render "partial/messages" %>
      <%= yield %>
    </div>
  </body>
</html>
