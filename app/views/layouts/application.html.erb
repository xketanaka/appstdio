<% setting = current_tenant&.setting -%>
<% light = setting.nil? || setting.light_title_color? -%>
<!DOCTYPE html>
<html>
  <head>
    <title><%= [[Settings.system_title, setting&.title_label].compact.join(" | "), content_for(:title)].compact_blank.join(" - ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="AppStdio">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>

    <link rel="icon" href="/favicon.ico" >

    <%# Web フォント。CSP を有効にするときは fonts.googleapis.com と fonts.gstatic.com を許可すること %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400..700&display=swap">
    <%= vite_client_tag %>
    <%= vite_stylesheet_tag "application" %>
    <%= vite_typescript_tag "application" %>
  </head>
  <body class="flex h-dvh flex-col overflow-hidden bg-canvas leading-relaxed text-slate-800">
    <header id="site-header"
            class="<%= class_names("flex shrink-0 items-center justify-between gap-2 px-3 py-2 sm:gap-4 sm:px-5",
                                   "mb-2 bg-canvas": setting&.title_color.nil?, "mb-3": setting&.title_color, "text-white": !light) %>"
            <% if setting&.title_color %>style="background-color: <%= setting.title_color %>"<% end %>>
      <div class="flex min-w-0 items-center gap-2 sm:gap-3">
        <% if logged_in? %>
          <button type="button" data-drawer-open aria-label="<%= t(".main_menu") %>"
                  class="<%= class_names("cursor-pointer rounded-full p-2",
                                         "text-slate-600 hover:bg-slate-900/5": light, "text-white/80 hover:bg-white/10": !light) %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 class="size-5" aria-hidden="true">
              <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        <% end %>
        <% title = setting&.title_label || Settings.system_title %>
        <div id="site-title" class="flex min-w-0 items-center gap-2.5">
          <% if setting&.logo&.attached? %>
            <%= image_tag setting.logo, alt: title, class: "h-8 w-auto shrink-0" %>
          <% else %>
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary-600 text-sm text-white" aria-hidden="true"><%= title.first %></span>
          <% end %>
          <% if setting&.title_label || !setting&.logo&.attached? %>
            <span class="truncate text-lg font-medium"><%= title %></span>
          <% end %>
        </div>
      </div>
      <% if logged_in? %>
        <div class="flex min-w-0 shrink-0 items-center gap-2 text-sm sm:gap-3">
          <% if current_tenant %>
            <span class="<%= class_names("hidden max-w-40 truncate rounded-full px-3 py-1 sm:inline-block",
                                         "bg-slate-900/5 text-slate-700": light, "bg-white/15": !light) %>"><%= current_tenant.name %></span>
          <% end %>
          <%= render layout: "partial/account_menu",
                locals: { label: t(".account_menu"),
                          name: current_tenant_user&.display_name || current_user&.email,
                          email: current_user&.email } do %>
            <%= link_to t("actions.profile"), profile_path,
                  class: "block px-4 py-2 hover:bg-slate-100" %>
            <% if current_tenant %>
              <%= link_to t("actions.switch_tenant"), select_tenant_path,
                    class: "block px-4 py-2 hover:bg-slate-100" %>
            <% end %>
            <%= button_to t("actions.logout"), logout_path, method: :delete,
                  class: "block w-full cursor-pointer px-4 py-2 text-left hover:bg-slate-100" %>
          <% end %>
        </div>
      <% end %>
    </header>

    <% if logged_in? %>
      <%= render layout: "partial/drawer" do %>
        <% if current_tenant&.files_setting&.enabled? %>
          <%= render "partial/drawer_item", label: t("menus.files"), path: files_root_path %>
        <% end %>
        <%= render "partial/drawer_item", label: t("menus.pages"), path: nil %>
        <%= render "partial/drawer_item", label: t("menus.chats"), path: nil %>
        <% if current_tenant_user&.admin_or_owner? %>
          <%= render "partial/drawer_item", label: t("menus.management"), path: management_root_path %>
        <% end %>
      <% end %>
    <% end %>

    <div class="shrink-0"><%= render "partial/messages" %></div>

    <div class="flex min-h-0 flex-1">
      <% if content_for?(:content) %>
        <%= yield :content %>
      <% elsif logged_in? %>
        <main class="mx-2 mb-2 flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden rounded-2xl bg-white sm:mx-4 sm:mb-4"><%= yield %></main>
      <% else %>
        <%= yield %>
      <% end %>
    </div>
  </body>
</html>
