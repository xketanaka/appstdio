<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || Settings.system_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="AppStdio">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>

    <link rel="icon" href="/favicon.ico" >

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "font-awesome.min" %>
    <%= stylesheet_link_tag "normalize" %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin">
    <header class="app-header app-header--admin">
      <div class="app-header__brand">
        <%= link_to "#{Settings.system_title} 管理", admin_root_path, class: "app-header__link" %>
      </div>
      <% if current_admin_user %>
        <div class="app-header__account">
          <span class="app-header__name"><%= current_admin_user.display_name %></span>
          <%= button_to t("actions.logout"), admin_logout_path, method: :delete, class: "btn btn--plain" %>
        </div>
      <% end %>
    </header>

    <div class="content">
      <%= render "partial/messages" %>
      <%= yield %>
    </div>
  </body>
</html>
