<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || Settings.system_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="AppStdio">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>

    <link rel="icon" href="/favicon.ico" >

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-slate-50 leading-relaxed text-slate-800">
    <header class="flex items-center justify-between gap-4 bg-slate-700 px-6 py-3 text-white">
      <div class="flex items-center gap-3">
        <% if current_admin_user %>
          <button type="button" data-drawer-open aria-label="<%= t(".main_menu") %>"
                  class="-ml-2 cursor-pointer rounded p-2 hover:bg-slate-600">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 class="size-5" aria-hidden="true">
              <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        <% end %>
        <div class="font-bold">
          <%= link_to t(".brand", system_title: Settings.system_title), admin_root_path, class: "hover:underline" %>
        </div>
      </div>
      <% if current_admin_user %>
        <div class="flex items-center gap-3 text-sm">
          <%= render layout: "partial/account_menu",
                locals: { label: t(".account_menu"),
                          name: current_admin_user.display_name,
                          email: current_admin_user.user.email } do %>
            <%= button_to t("actions.logout"), admin_logout_path, method: :delete,
                  class: "block w-full cursor-pointer px-4 py-2 text-left hover:bg-slate-100" %>
          <% end %>
        </div>
      <% end %>
    </header>

    <% if current_admin_user %>
      <%= render layout: "partial/drawer" do %>
        <%= render "partial/drawer_item", label: t("menus.tenants"), path: admin_tenants_path %>
        <%= render "partial/drawer_item", label: t("menus.admin_users"), path: nil %>
      <% end %>
    <% end %>

    <div class="mx-auto max-w-5xl px-4 py-8">
      <%= render "partial/messages" %>
      <%= yield %>
    </div>
  </body>
</html>
