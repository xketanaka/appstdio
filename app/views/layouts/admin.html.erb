<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || Settings.system_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="AppStdio">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>

    <link rel="icon" href="/favicon.ico" >

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-slate-50 leading-relaxed text-slate-800">
    <header class="flex flex-wrap items-center justify-between gap-4 bg-slate-700 px-6 py-3 text-white">
      <div class="font-bold">
        <%= link_to "#{Settings.system_title} 管理", admin_root_path, class: "hover:underline" %>
      </div>
      <% if current_admin_user %>
        <div class="flex items-center gap-4 text-sm">
          <span><%= current_admin_user.display_name %></span>
          <%= button_to t("actions.logout"), admin_logout_path, method: :delete,
                class: "cursor-pointer rounded border border-slate-400 px-3 py-1 hover:bg-slate-600" %>
        </div>
      <% end %>
    </header>

    <div class="mx-auto max-w-5xl px-4 py-8">
      <%= render "partial/messages" %>
      <%= yield %>
    </div>
  </body>
</html>
