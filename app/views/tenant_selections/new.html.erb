<% content_for :title do %><%= t(".title") %><% end -%>
<div class="min-h-0 flex-1 overflow-y-auto">
  <div class="mx-auto w-full max-w-3xl px-4 py-6 sm:px-6 sm:py-8">
    <h1 class="mb-6 text-title"><%= t(".heading") %></h1>

    <% if @tenant_users.empty? %>
      <p class="text-slate-500"><%= t("messages.no_tenant") %></p>
    <% else %>
      <ul id="tenant-list" class="divide-y divide-slate-200 border-y border-slate-200">
        <% @tenant_users.each do |tenant_user| %>
          <li class="flex items-center justify-between gap-4 py-4">
            <div class="min-w-0">
              <div class="truncate font-semibold"><%= tenant_user.tenant.name %></div>
              <div class="truncate text-sm text-slate-500">
                <%= t("enums.tenant_user.role.#{tenant_user.role}") %> / <%= tenant_user.display_name %>
              </div>
            </div>
            <%= button_to t("actions.select"), select_tenant_path,
                  params: { tenant_id: tenant_user.tenant_id },
                  class: "btn btn-primary btn-sm" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
